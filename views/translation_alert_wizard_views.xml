<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View of the Alert Wizard -->
    <record id="view_translation_alert_wizard_form" model="ir.ui.view">
        <field name="name">translation.alert.wizard.form</field>
        <field name="model">translation.alert.wizard</field>
        <field name="arch" type="xml">
            <form string="Alerta del Agente Supervisor">
                <p class="alert alert-warning" style="margin-bottom:15px; font-weight:bold;">
                    ⚠️ El Supervisor de Coherencia requiere su aprobación institucional para resolver una ambigüedad narrativa.
                </p>
                <group>
                    <field name="text_original" readonly="1"/>
                    <field name="selected_option" widget="radio"/>
                    <field name="custom_text" placeholder="Si ninguna opción es ideal, escriba aquí la traducción institucional..."
                           attrs="{'invisible': [('selected_option', '!=', 'none'), ('selected_option', '!=', False)], 'required': [('selected_option', '=', 'none')]}"/>
                </group>
                <footer>
                    <button name="action_apply_and_resume" string="Aprobar y Reanudar Flujo" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Wizard in new modal target -->
    <record id="action_view_translation_alert_wizard" model="ir.actions.act_window">
        <field name="name">Resolver Conflicto Narrativo</field>
        <field name="res_model">translation.alert.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
